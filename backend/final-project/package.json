{
  "name": "backend-final-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Final project - a production-shaped Task API on PostgreSQL, using the DATABASE_URL from your .env.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:migrate:status": "tsx src/cli/migrate.ts status",
    "db:migrate:down": "tsx src/cli/migrate.ts down",
    "db:seed": "tsx src/cli/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
