# Copy this file to .env and fill in your own values. NEVER commit .env.
#
# PostgreSQL connection string used by the final-project backend (Prisma).
# Local example:
#   DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/sooqonline"
# Hosted (e.g. Railway/Supabase/Neon) example:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Long random string used to sign JWTs. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on (optional, defaults to 3000)
PORT=3000
