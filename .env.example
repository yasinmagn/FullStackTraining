# =============================================================================
# FullStackTraining - environment template
# =============================================================================
# Copy this file to `.env` and fill in REAL values there.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
# =============================================================================

# --- Backend: HTTP server ---------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Backend: PostgreSQL ----------------------------------------------------
# Used by backend/stage-4 onwards and by backend/final-project.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_training

# Set to `true` when your Postgres requires TLS (most managed/cloud providers do).
DATABASE_SSL=false

# A SEPARATE database used by the backend integration tests.
# The test suites TRUNCATE tables, so this must never point at a database whose
# data you care about. Tests SKIP - they do not fail - when this is unset, and
# they deliberately do NOT fall back to DATABASE_URL.
#   createdb fullstack_training_test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_training_test

# Connection pool tuning (optional; sane defaults are used if omitted).
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# --- Backend: auth ----------------------------------------------------------
# Generate your own, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

# --- Frontend ---------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never put a secret behind a VITE_ prefix - it ships to every visitor.
VITE_API_BASE_URL=http://localhost:3000
