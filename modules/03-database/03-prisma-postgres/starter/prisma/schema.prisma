model OrderItem {
  id        Int     @id @default(autoincrement())
  // TODO 4: order relation (onDelete: Cascade), product relation,
  // quantity Int, unitPrice Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
  productId Int
}
