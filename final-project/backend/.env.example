# Copy to .env and fill in your own values. NEVER commit .env.
# PostgreSQL connection string (local or hosted — Railway/Supabase/Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Long random string for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on (optional).
PORT=3000
